        "g": "6b21666697b052ae",
        "name": "save furnace",
        "func": "const name = String(msg.payload.name || '').trim();\nconst plcId = Number(msg.payload.plc_identifier);\n\nif (!name) {\n    return [null, { payload: 'Informe o nome da fornalha.' }];\n}\nif (![1, 2, 3].includes(plcId)) {\n    return [null, { payload: 'Selecione o identificador do CLP (1 a 3).' }];\n}\n\nconst id = flow.get('furnaceId');\nflow.set('furnaceId', null);\n\nif (id) {\n    return [{\n        topic: 'UPDATE furnaces SET name = ?, plc_identifier = ?, updated_at = CURRENT_TIMESTAMP(3) WHERE id = ?',\n        payload: [name, plcId, id],\n        statusText: 'Fornalha atualizada.'\n    }, null];\n}\n\nreturn [{\n    topic: 'INSERT INTO furnaces (name, plc_identifier) VALUES (?, ?)',\n    payload: [name, plcId],\n    statusText: 'Fornalha cadastrada.'\n}, null];",
