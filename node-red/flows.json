    {
        "id": "c65b7e7edcc5d76e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "g": "d5f817db75b74b5f",
        "name": "handshake",
        "func": "const d = msg.payload;\nconst busy = flow.get('busy') || false;\n\nif (d.ready && !d.done && !busy) {\n    if (d.furnace < 1 || d.furnace > 3) {\n        node.warn('Invalid furnace: ' + d.furnace);\n        return [null, { payload: true }, null];\n    }\n    flow.set('busy', true);\n    const producedAt = new Date(d.timestamp).toISOString().slice(0, 23).replace('T', ' ');\n    return [null, null, {\n        topic: 'INSERT INTO products (furnace_plc_identifier, produced_at, hardness) VALUES (?, ?, ?)',\n        payload: [d.furnace, producedAt, d.hardness]\n    }];\n}\n\nif (!d.ready && d.done) {\n    flow.set('busy', false);\n    return [{ payload: false }, { payload: false }, null];\n}\n\nif (!d.trigger && !d.ready && !d.done) {\n    return [{ payload: true }, null, null];\n}\n\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 360,
        "wires": [
